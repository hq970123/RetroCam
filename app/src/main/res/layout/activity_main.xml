<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.hq.retrocam.ui.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/ghost"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0.45"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFF" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="36dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView android:id="@+id/btnFlash" style="@style/TopBtn" android:text="闪光 关" />
        <TextView android:id="@+id/btnTimer" style="@style/TopBtn" android:text="定时 关" />
        <TextView android:id="@+id/btnRatio" style="@style/TopBtn" android:text="4:3" />
        <TextView android:id="@+id/btnFormat" style="@style/TopBtn" android:text="1080p 30" android:visibility="gone" />
        <TextView android:id="@+id/btnDate" style="@style/TopBtn" android:text="日期 开" />
        <TextView android:id="@+id/btnAssist" style="@style/TopBtn" android:text="辅助 ▾" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/assistPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="84dp"
        android:background="@color/panel"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView android:id="@+id/asGrid" style="@style/FxChip" android:text="网格" />
            <TextView android:id="@+id/asLevel" style="@style/FxChip" android:text="水平仪" />
            <TextView android:id="@+id/asHist" style="@style/FxChip" android:text="直方图" />
            <TextView android:id="@+id/asPeak" style="@style/FxChip" android:text="峰值对焦" />
            <TextView android:id="@+id/asZebra" style="@style/FxChip" android:text="斑马纹" />
            <TextView android:id="@+id/asRaw" style="@style/FxChip" android:text="RAW" />
            <TextView android:id="@+id/asStab" style="@style/FxChip" android:text="防抖" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Recording HUD -->
    <LinearLayout
        android:id="@+id/recHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="100dp"
        android:background="@drawable/chip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <View android:id="@+id/recDot" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/shutter_video" />
        <TextView android:id="@+id/recTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:fontFamily="monospace" android:text="REC 00:00" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <com.hq.retrocam.ui.AudioMeterView android:id="@+id/audioMeter" android:layout_width="64dp" android:layout_height="12dp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/creativeHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="140dp"
        android:background="@drawable/chip_bg"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="#FFB547"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:shadowColor="#000000"
        android:shadowRadius="12"
        android:textColor="#FFFFFF"
        android:textSize="96sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/chip_bg"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Bottom panel -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/sliderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:visibility="gone">
            <TextView android:id="@+id/sliderLabel" android:layout_width="84dp" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textColor="#FFB547" android:textSize="15sp" android:textStyle="bold" />
            <SeekBar android:id="@+id/slider" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" />
            <TextView android:id="@+id/sliderAuto" style="@style/FxChip" android:text="A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp">
            <TextView android:id="@+id/tabFx" style="@style/ModeText" android:textSize="13sp" android:text="效果" />
            <TextView android:id="@+id/tabPro" style="@style/ModeText" android:textSize="13sp" android:text="专业" />
            <TextView android:id="@+id/tabColor" style="@style/ModeText" android:textSize="13sp" android:text="调色" />
            <TextView android:id="@+id/tabCreative" style="@style/ModeText" android:textSize="13sp" android:text="创意" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/creativePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/creativeStrip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" />
            </HorizontalScrollView>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/optStrip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" />
            </HorizontalScrollView>
            <HorizontalScrollView android:id="@+id/borderScroll" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/borderStrip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/colorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <TextView android:id="@+id/colLog" style="@style/FxChip" android:text="Log 关" />
                    <TextView android:id="@+id/colConvert" style="@style/FxChip" android:text="内置转换 开" />
                    <TextView android:id="@+id/colBurn" style="@style/FxChip" android:text="烧录 开" />
                </LinearLayout>
            </HorizontalScrollView>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/lutStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp">
                <TextView android:id="@+id/lutLabel" android:layout_width="96dp" android:layout_height="wrap_content"
                    android:text="LUT 100%" android:textColor="#FFB547" android:textSize="13sp" android:textStyle="bold" />
                <SeekBar android:id="@+id/lutSeek" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:max="100" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/proRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <TextView android:id="@+id/proIso" style="@style/FxChip" android:fontFamily="monospace" android:text="ISO A" />
                <TextView android:id="@+id/proShutter" style="@style/FxChip" android:fontFamily="monospace" android:text="S A" />
                <TextView android:id="@+id/proEv" style="@style/FxChip" android:fontFamily="monospace" android:text="EV 0" />
                <TextView android:id="@+id/proWb" style="@style/FxChip" android:text="WB 自动" />
                <TextView android:id="@+id/proFocus" style="@style/FxChip" android:fontFamily="monospace" android:text="MF A" />
                <TextView android:id="@+id/proReset" style="@style/FxChip" android:text="全自动" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/fxRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="6dp">
            <TextView android:id="@+id/fxGrain" style="@style/FxChip" android:text="颗粒" />
            <TextView android:id="@+id/fxVignette" style="@style/FxChip" android:text="暗角" />
            <TextView android:id="@+id/fxLeak" style="@style/FxChip" android:text="漏光" />
            <TextView android:id="@+id/fxIntensity" style="@style/FxChip" android:text="强度 100%" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/styleStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView android:id="@+id/modePhoto" style="@style/ModeText" android:text="拍照" />
            <TextView android:id="@+id/modeVideo" style="@style/ModeText" android:text="录像" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="36dp"
                android:background="@drawable/thumb_bg"
                android:clipToOutline="true"
                android:padding="2dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/shutter"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/shutter_photo" />

            <TextView
                android:id="@+id/btnFlip"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="36dp"
                android:background="@drawable/round_btn"
                android:gravity="center"
                android:text="⟲"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Photo editor -->
    <LinearLayout
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="36dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">
            <TextView android:id="@+id/editCancel" style="@style/FxChip" android:text="取消" />
            <TextView android:id="@+id/editTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center" android:text="编辑" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/editSave" style="@style/FxChip" android:text="保存副本" android:textColor="#FFB547" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ImageView android:id="@+id/editImage" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" />
            <ProgressBar android:id="@+id/editBusy" android:layout_width="40dp" android:layout_height="40dp"
                android:layout_gravity="center" android:visibility="gone" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/panel" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="28dp">
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"
                    android:paddingStart="8dp" android:paddingEnd="8dp">
                    <TextView android:id="@+id/editIntensity" style="@style/FxChip" android:text="强度 100%" />
                    <TextView android:id="@+id/editGrain" style="@style/FxChip" android:text="颗粒" />
                    <TextView android:id="@+id/editVignette" style="@style/FxChip" android:text="暗角" />
                    <TextView android:id="@+id/editLeak" style="@style/FxChip" android:text="漏光" />
                    <TextView android:id="@+id/editDate" style="@style/FxChip" android:text="日期" />
                </LinearLayout>
            </HorizontalScrollView>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/editStyleStrip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" />
            </HorizontalScrollView>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/editLutStrip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" />
            </HorizontalScrollView>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/editBorderStrip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
